rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public PG catalogue: anyone can view published listings, only signed-in staff can edit.
    match /listings/{listingId} {
      allow read: if resource == null || resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Website visitors can submit enquiries; only signed-in staff can read or manage them.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['id', 'propertyId', 'name', 'phone', 'message', 'preferredSharing', 'moveInDate', 'status', 'createdAt'])
                    && request.resource.data.status == 'new';
      allow read, update, delete: if request.auth != null;
    }

    // For development/testing. 
    // CHANGE THIS BEFORE GOING TO PRODUCTION to: allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
